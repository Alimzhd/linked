# GEMINI_API_KEY: Required for Gemini AI API calls (charm recommendations / copy).
# Vite only exposes keys prefixed with VITE_ to the client bundle.
# Set both to the same value for local development.
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# APP_URL: Canonical URL for the deployed app (self-referential links).
APP_URL="http://localhost:5173"
VITE_APP_URL="http://localhost:5173"

# Optional store WhatsApp dispatch number (digits only, country code included).
VITE_WHATSAPP_NUMBER="6281234567890"
